    "contact": "<div class=\"ar-form\" data-redirect=\"http://example.test/form-submitted/\"><form class=\"form\" data-demo><div class=\"grid-2\"><div class=\"field\"><label for=\"c-name\">Your names</label><input id=\"c-name\" name=\"names\" type=\"text\" placeholder=\"Fern &amp; Callum\" required></div><div class=\"field\"><label for=\"c-email\">Email</label><input id=\"c-email\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" required></div></div><div class=\"grid-2\"><div class=\"field\"><label for=\"c-date\">Wedding date <span class=\"lbl-plain\">(or roughly when)</span></label><input id=\"c-date\" name=\"date\" type=\"text\" placeholder=\"14 September 2027\"></div><div class=\"field\"><label for=\"c-where\">Where in the world</label><input id=\"c-where\" name=\"location\" type=\"text\" placeholder=\"Venue, or ‘still deciding’\"></div></div><div class=\"grid-2\"><div class=\"field\"><label for=\"c-type\">What are you planning</label><select id=\"c-type\" name=\"type\"><option>A full wedding day</option><option>An elopement or intimate ceremony</option><option>A whole wedding weekend</option><option>An engagement session</option><option>Something else entirely</option></select></div><div class=\"field\"><label for=\"c-found\">How did you find me</label><select id=\"c-found\" name=\"found\"><option>Instagram</option><option>Pinterest</option><option>A friend or family member</option><option>My venue recommended you</option><option>Google</option><option>I cannot remember</option></select></div></div><div class=\"field\"><label for=\"c-msg\">Tell me about your day</label><textarea id=\"c-msg\" name=\"message\" placeholder=\"The place, the people, the feeling you are after. Anything at all — there is no wrong amount to write here.\"></textarea></div><div class=\"form-foot\"><button type=\"submit\" class=\"btn\">Send my enquiry</button><p class=\"note\">A reply within two days, always from me.</p><p class=\"form-msg\">Thank you — your enquiry has been 